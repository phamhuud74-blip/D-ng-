-- 5. LẮP RÁP CÁC KHỚP VÀ VÒNG LẶP NẮM CỔ
local function GetRightShoulder(char)
    if not char then return nil end
    if char:FindFirstChild("Torso") and char.Torso:FindFirstChild("Right Shoulder") then
        return char.Torso["Right Shoulder"]
    elseif char:FindFirstChild("RightUpperArm") and char.RightUpperArm:FindFirstChild("RightShoulder") then
        return char.RightUpperArm.RightShoulder
    end
    return nil
end

RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    if not char or not isMonsterMode then return end
    
    if isGrabbing then
        local shoulder = GetRightShoulder(char)
        if shoulder then
            if not savedShoulderC0 then savedShoulderC0 = shoulder.C0 end
            shoulder.C0 = CFrame.new(shoulder.C0.Position) * CFrame.Angles(math.rad(90), 0, math.rad(15))
        end
        
        if grabbedTarget and grabbedTarget.Character and grabbedTarget.Character:FindFirstChild("HumanoidRootPart") then
            local myHrp = char:FindFirstChild("HumanoidRootPart")
            local targetHrp = grabbedTarget.Character.HumanoidRootPart
            if myHrp and targetHrp then
                targetHrp.CFrame = myHrp.CFrame * CFrame.new(0.6, 1.2, -2.2) * CFrame.Angles(0, math.rad(180), 0)
                targetHrp.Velocity = Vector3.new(0, 0, 0)
            end
        end
    else
        local shoulder = GetRightShoulder(char)
        if shoulder and savedShoulderC0 then
            shoulder.C0 = savedShoulderC0
            savedShoulderC0 = nil
        end
    end
end)

-- 6. TÌM NGƯỜI CHƠI TRƯỚC MẶT
local function GetNearestPlayerInFront()
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil end
    local myHrp = myChar.HumanoidRootPart
    
    local closestPlr = nil
    local minDistance = 18
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local targetHrp = plr.Character.HumanoidRootPart
            local dist = (targetHrp.Position - myHrp.Position).Magnitude
            if dist < minDistance then
                local dir = (targetHrp.Position - myHrp.Position).Unit
                if myHrp.CFrame.LookVector:Dot(dir) > 0.1 then
                    minDistance = dist
                    closestPlr = plr
                end
            end
        end
    end
    return closestPlr
end

-- 7. CHỨC NĂNG 1: SERVER PHẲNG
local function ToggleFlatServer(enable)
    isFlatServer = enable
    if enable then
        for _, obj in ipairs(Workspace:GetChildren()) do
            if obj ~= LocalPlayer.Character and not Players:GetPlayerFromCharacter(obj) and obj.Name ~= "Terrain" then
                if obj:IsA("BasePart") or obj:IsA("Model") or obj:IsA("Folder") then
                    table.insert(hiddenMapObjects, {instance = obj, parent = obj.Parent})
                    obj.Parent = nil
                end
            end
        end
        
        createdBaseplate = Instance.new("Part")
        createdBaseplate.Name = "DuongvatvnBaseplate"
        createdBaseplate.Size = Vector3.new(2000, 1, 2000)
        createdBaseplate.Position = Vector3.new(0, 0, 0)
        createdBaseplate.Anchored = true
        createdBaseplate.Material = Enum.Material.SmoothPlastic
        createdBaseplate.Color = Color3.fromRGB(50, 50, 60)
        createdBaseplate.Parent = Workspace
        
        local myChar = LocalPlayer.Character
        if myChar and myChar:FindFirstChild("HumanoidRootPart") then
            myChar.HumanoidRootPart.CFrame = CFrame.new(0, 5, 0)
        end
    else
        if createdBaseplate then
            createdBaseplate:Destroy()
            createdBaseplate = nil
        end
        for _, item in ipairs(hiddenMapObjects) do
            if item.instance then
                item.instance.Parent = item.parent
            end
        end
        hiddenMapObjects = {}
    end
end

