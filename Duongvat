local function ToggleMonsterMode(enable)
    isMonsterMode = enable
    local char = LocalPlayer.Character
    if not char then return end
    
    if enable then
        local head = char:FindFirstChild("Head")
        if head then
            for _, offset in ipairs({Vector3.new(-0.25, 0.2, -0.55), Vector3.new(0.25, 0.2, -0.55)}) do
                local eye = Instance.new("Part")
                eye.Size = Vector3.new(0.2, 0.2, 0.2)
                eye.Color = Color3.fromRGB(255, 0, 0)
                eye.Material = Enum.Material.Neon
                eye.CanCollide = false
                
                local weld = Instance.new("Weld")
                weld.Part0 = head
                weld.Part1 = eye
                weld.C0 = CFrame.new(offset)
                weld.Parent = eye
                
                table.insert(eyeParts, eye)
            end
        end
        
        monsterConn = RunService.RenderStepped:Connect(function()
            if not isMonsterMode then return end
            local headPart = char:FindFirstChild("Head")
            local neck = headPart and (headPart:FindFirstChild("Neck") or (char:FindFirstChild("Torso") and char.Torso:FindFirstChild("Neck")) or (char:FindFirstChild("UpperTorso") and char.UpperTorso:FindFirstChild("Neck")))
            if neck then
                if not originalNeckC0 then originalNeckC0 = neck.C0 end
                if math.random(1, 4) == 1 then
                    neck.C0 = originalNeckC0 * CFrame.Angles(
                        math.rad(math.random(-15, 15)),
                        math.rad(math.random(-15, 15)),
                        math.rad(math.random(-15, 15))
                    )
                end
            end
        end)
    else
        if monsterConn then monsterConn:Disconnect() monsterConn = nil end
        for _, eye in ipairs(eyeParts) do if eye then eye:Destroy() end end
        eyeParts = {}
        isGrabbing = false
        grabbedTarget = nil
    end
end

