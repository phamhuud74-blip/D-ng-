            local targetHrp = grabbedTarget.Character:FindFirstChild("HumanoidRootPart")
            local targetPlrName = grabbedTarget.Name
            
            isGrabbing = false
            grabbedTarget = nil
            
            if targetHrp then
                local throwDir = myHrp.CFrame.LookVector * 120 + Vector3.new(0, 50, 0)
                task.spawn(function()
                    for i = 1, 12 do
                        if targetHrp then
                            targetHrp.CFrame = targetHrp.CFrame + (myHrp.CFrame.LookVector * 8) + Vector3.new(0, 3, 0)
                            targetHrp.Velocity = throwDir
                        end
                        task.wait(0.015)
                    end
                end)
            end
            
            StatusLabel.Text = "🔥 Đã NÉM " .. targetPlrName .. " bay xa!"
            StatusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
            return
        end
        
        -- LẦN CHẠM 1: NẮM CỔ
        local targetPlr = GetNearestPlayerInFront()
        if targetPlr and targetPlr.Character then
            grabbedTarget = targetPlr
            isGrabbing = true
            
            StatusLabel.Text = "✊ ĐANG NẮM CỔ: " .. targetPlr.Name .. "\nNhấn màn hình lần nữa để NÉM!"
            StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
        end
    end
end)

