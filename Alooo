        origC0Left = leftShoulder.C0
        leftShoulder.C0 = leftShoulder.C0 * CFrame.Angles(0, 0, math.rad(-90))
    end
    if rightShoulder then
        origC0Right = rightShoulder.C0
        rightShoulder.C0 = rightShoulder.C0 * CFrame.Angles(0, 0, math.rad(90))
    end

    -------------------------------------------------------
    -- BƯỚC 4: HIỆU ỨNG AURA & SẤM SÉT ĐÁNH ĐÙNG ĐÙNG
    -------------------------------------------------------
    -- Aura bao quanh người
    local aura = Instance.new("Highlight")
    aura.FillColor = Color3.fromRGB(0, 255, 255)
    aura.OutlineColor = Color3.fromRGB(255, 255, 255)
    aura.FillTransparency = 0.2
    aura.Parent = character

    local particle = Instance.new("ParticleEmitter")
    particle.Texture = "rbxassetid://243664672"
    particle.Color = ColorSequence.new(Color3.fromRGB(0, 255, 255), Color3.fromRGB(255, 255, 255))
    particle.Size = NumberSequence.new(2, 4)
    particle.Rate = 60
    particle.Speed = NumberRange.new(6, 12)
    particle.Parent = hrp

    -- Sấm sét đánh xung quanh trong 2 giây
    local lightningThread = task.spawn(function()
        for i = 1, 10 do
            local bolt = Instance.new("Part")
            bolt.Size = Vector3.new(0.6, 30, 0.6)
            bolt.Color = Color3.fromRGB(255, 255, 120)
            bolt.Material = Enum.Material.Neon
            bolt.Anchored = true
            bolt.CanCollide = false
            
            local offset = Vector3.new(math.random(-10, 10), 10, math.random(-10, 10))
            bolt.CFrame = CFrame.new(hrp.Position + offset) * CFrame.Angles(math.rad(math.random(-25, 25)), 0, math.rad(math.random(-25, 25)))
            bolt.Parent = workspace
            Debris:AddItem(bolt, 0.12)

            task.wait(0.2)
        end
    end)

    -------------------------------------------------------
    -- BƯỚC 5: PHÁT NỔ SAU 2 GIÂY & HẤT VĂNG NGƯỜI CHƠI KHÁC
    -------------------------------------------------------
    task.wait(2)

    -- Hiệu ứng vụ nổ
    local explosion = Instance.new("Explosion")
    explosion.Position = hrp.Position
    explosion.BlastRadius = 40
    explosion.BlastPressure = 0 -- Tránh kill người chơi nếu map cấm
    explosion.DestroyPartRadiusHit = 0
    explosion.Parent = workspace

    -- Hất văng người chơi khác trong bán kính 40 studs
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local otherHrp = player.Character.HumanoidRootPart
            local distance = (otherHrp.Position - hrp.Position).Magnitude
            
            if distance <= 40 then
                local pushDirection = (otherHrp.Position - hrp.Position).Unit
                local bodyPush = Instance.new("BodyVelocity")
                bodyPush.MaxForce = Vector3.new(1e6, 1e6, 1e6)
                -- Lực hất văng cực mạnh ra xa và lên cao
                bodyPush.Velocity = (pushDirection * 150) + Vector3.new(0, 80, 0)
                bodyPush.Parent = otherHrp
                Debris:AddItem(bodyPush, 0.5)
            end
        end
    end

    -- Phát nổ bản thân & dọn dẹp hiệu ứng
    bodyVelocity:Destroy()
    aura:Destroy()
    particle:Destroy()
    
    if humanoid then 
        humanoid.Health = 0 -- Reset nhân vật khi phát nổ
    end

    -- Trả lại góc vai ban đầu
    if leftShoulder and origC0Left then leftShoulder.C0 = origC0Left end
    if rightShoulder and origC0Right then rightShoulder.C0 = origC0Right end

    task.wait(2)
    isRunning = false
end

