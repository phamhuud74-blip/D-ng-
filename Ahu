    end

    return label
end

-- Gọi API AI Chat
local function FetchAIResponse(prompt)
    local success, responseText = pcall(function()
        local encoded = HttpService:UrlEncode(prompt)
        local url = "https://api.popcat.xyz/chatbot?owner=Duongvatvn&botname=Gemini&message=" .. encoded
        
        if httpRequest then
            local res = httpRequest({Url = url, Method = "GET"})
            if res and res.Body then
                local data = HttpService:JSONDecode(res.Body)
                return data.response
            end
        else
            local res = game:HttpGet(url)
            if res then
                local data = HttpService:JSONDecode(res)
                return data.response
            end
        end
    end)

    if success and responseText and responseText ~= "" then
        return responseText
    else
        return "Xin lỗi, kết nối bận hoặc Delta X chưa bật HTTP. Vui lòng thử lại sau!"
    end
end

